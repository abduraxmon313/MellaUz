{
  "name": "mella",
  "private": true,
  "description": "MELLA — premium brend sayti va Telegram bot (pnpm monorepo, Railway)",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/railway-dispatch.mjs build",
    "start": "node scripts/railway-dispatch.mjs start",
    "build:all": "pnpm --filter \"./apps/*\" build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter mella-web dev",
    "dev:bot": "pnpm --filter mella-bot dev",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck"
  }
}
