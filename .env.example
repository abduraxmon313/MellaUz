# ─────────────────────────────────────────────────────────────
#  MELLA — muhit o'zgaruvchilari namunasi
#  Railway'da har bir service uchun kerakli qiymatlarni qo'ying.
#  (Maxfiy qiymatlarni repoga joylashtirmang — bu faqat namuna.)
# ─────────────────────────────────────────────────────────────

# ===== SERVICE: mella-web (brend sayti) =====

# Sayt bazaviy URL'i (SEO: canonical, sitemap, og). Railway domenini qo'ying.
NEXT_PUBLIC_SITE_URL=https://mella.uz

# Brend aloqa ma'lumotlari (saytda ko'rinadi; bo'sh bo'lsa ko'rsatilmaydi)
NEXT_PUBLIC_PHONE=+998 90 123 45 67
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/mella_uz/
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS_UZ=Toshkent, O‘zbekiston
NEXT_PUBLIC_ADDRESS_RU=Ташкент, Узбекистан
NEXT_PUBLIC_ADDRESS_EN=Tashkent, Uzbekistan
NEXT_PUBLIC_HOURS=10:00 – 20:00

# Buyurtma so'rovlari (lead) uchun bizning PostgreSQL (Railway Postgres plugin)
# Qo'yilmasa — so'rovlar DB'ga saqlanmaydi (faqat Telegram'ga yuboriladi).
DATABASE_URL=

# ── /admin — mahsulotlarni qo'lda kiritish (vaqtinchalik, ERP ulanguncha) ──
# Admin panel paroli (https://<sayt>/admin). Bo'sh bo'lsa — panelga kirib bo'lmaydi.
ADMIN_PASSWORD=
# (ixtiyoriy) sessiya imzosi uchun qo'shimcha maxfiy kalit. O'zgartirilsa — hamma chiqib ketadi.
ADMIN_SESSION_SECRET=
# Mini App (mella-bot) bazasi. Admin qo'shgan mahsulot shu bazaga ham yoziladi (Mini App'da faqat MINIAPP_MANUAL_PRODUCTS=true bo'lsa chiqadi).
# Railway: mella-web → Variables → BOT_DATABASE_URL = ${{<bot Postgres nomi>.DATABASE_URL}}
BOT_DATABASE_URL=

# Saytdagi "buyurtma so'rovi" operatorга Telegram orqali tushishi uchun.
# Qo'yilmasa — xabar yuborilmaydi (so'rov baribir DB'ga saqlanadi).
TELEGRAM_LEAD_BOT_TOKEN=
TELEGRAM_LEAD_CHAT_ID=

# ERP integratsiyasi (mahsulot/kategoriya/narx/qoldiq). Qo'yilmasa — namuna
# (mock) katalog ishlatiladi. ERP aniqlangach to'ldiriladi.
ERP_API_BASE_URL=
ERP_API_KEY=
ERP_CACHE_SECONDS=300
# ERP rasmlari qaysi domen(lar)dan kelishi (vergul bilan), Next/Image uchun
ERP_IMAGE_HOSTS=


# ===== SERVICE: mella-bot (2 ta Telegram bot + Mini App) =====

# Mijoz (sotuv) boti tokeni (BotFather). Bo'sh bo'lsa faqat Mini App va /health ishlaydi.
BOT_CUSTOMER_TOKEN=
# Admin bot tokeni — yangi buyurtmalar shu botga keladi, holat shu yerda boshqariladi.
# Bo'sh bo'lsa kartalar mijoz boti orqali adminlarga yuboriladi (zaxira).
BOT_ADMIN_TOKEN=
# Egalar (asosiy adminlar) Telegram ID'lari (vergul bilan). ID'ni bilish: admin botga /start yozing.
# Qo'shimcha adminlarni egalar admin botda "👥 Adminlar" orqali qo'shadi.
ADMIN_IDS=

# Ommaviy domen — Railway avtomatik `RAILWAY_PUBLIC_DOMAIN` beradi.
PUBLIC_URL=
# Webhook maxfiy tokeni (faqat A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=mella-webhook

# Buyurtmalar, mijozlar, rasm keshi (Railway Postgres). Bo'sh bo'lsa — xotira (faqat sinov!)
DATABASE_URL=

# ── BILLZ 2.0 (ERP) — https://docs.billz.io ──
# BILLZ → Настройки → Настройки компании → Ключи интеграции. Bo'sh bo'lsa — Mini App katalogi bo'sh.
BILLZ_SECRET_TOKEN=
BILLZ_API_URL=https://api-admin.billz.ai
# Qaysi do'kon(lar) narxi/qoldig'i ko'rsatiladi (vergul bilan). ID'lar: admin botda /billz.
# Bo'sh — barcha filiallar qoldig'i yig'iladi. Tovar ro'yxatda yo'q filialda tursa — Mini App'da "Tugagan".
BILLZ_SHOP_IDS=
# Faqat o'zgargan tovarlarni yangilash oralig'i, daqiqa (BILLZ tavsiyasi: 5 dan kam emas)
BILLZ_SYNC_MINUTES=5
# To'liq qayta yuklash oralig'i, daqiqa (o'chirilgan tovarlarni olib tashlash uchun)
BILLZ_FULL_SYNC_MINUTES=180
# true — qoldig'i yo'q mahsulotlar umuman ko'rsatilmaydi
BILLZ_HIDE_OUT_OF_STOCK=false
# true (sukut) — Mini App'da faqat admin botda rasmi tasdiqlangan BILLZ mahsulotlari ko'rinadi.
# false — barcha BILLZ mahsulotlari ko'rinadi (tasdiqlangan rasm baribir ishlatiladi).
BILLZ_REQUIRE_APPROVAL=true
# true — sayt /admin panelida qo'lda kiritilgan (eski) mahsulotlar ham Mini App'da ko'rinadi. Sukut: false.
MINIAPP_MANUAL_PRODUCTS=false
# true (sukut) — Mini App'da nomdan model raqami olib tashlanadi: "Lafiera 17" -> "Lafiera"
MINIAPP_STRIP_MODEL_NUMBER=true
# Mahsulot oynasida ko'rsatilmaydigan BILLZ xususiyatlari (vergul bilan, nomi bo'yicha). Ichki maydonlar avtomatik yashiriladi.
MINIAPP_HIDDEN_FIELDS=

# ── OpenAI — admin botda mahsulot rasmining fonini tozalash ──
# Bo'sh bo'lsa AI o'chiq: admin faqat asl rasmni saqlay oladi.
OPENAI_API_KEY=
# (ixtiyoriy) model, sifat (low|medium|high), o'lcham (Mini App kartasi 4:5), o'z promptingiz
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1024x1280
OPENAI_IMAGE_PROMPT=
# true — "Yetkazildi" bo'lgan buyurtma BILLZ'ga sotuv sifatida o'tkaziladi (qoldiq kamayadi)
BILLZ_PUSH_SALES=false
BILLZ_SALE_SHOP_ID=
BILLZ_CASHBOX_ID=
BILLZ_PAYMENT_TYPE_CASH=
BILLZ_PAYMENT_TYPE_CLICK=

# ── Do'kon va yetkazib berish (Mini App'da ko'rinadi) ──
SHOP_NAME=MELLA
SHOP_PHONE=+998 90 123 45 67
SHOP_ADMIN_CONTACT=
SHOP_INSTAGRAM=https://www.instagram.com/mella_uz/
SHOP_ADDRESS=Toshkent
SHOP_LAT=
SHOP_LNG=
SHOP_HOURS=10:00 – 20:00
DELIVERY_FEE=0
FREE_DELIVERY_FROM=0
EXPRESS_DELIVERY_FEE=0
MIN_ORDER_AMOUNT=0
ALLOW_PICKUP=true
# Yandex Maps JS API kaliti (checkout'dagi xarita). Bo'sh bo'lsa manzil matn bilan yoziladi.
YANDEX_MAPS_API_KEY=
# Click integratsiyasi keyingi bosqichda — hozircha Mini App'da "Tez kunda".
CLICK_ENABLED=false
